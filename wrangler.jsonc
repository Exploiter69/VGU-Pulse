{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vgu-pulse",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./web"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vgu-pulse",
      "database_id": "b774ba2d-405d-40d2-95bd-6ca47e3347ef",
      "migrations_dir": "migrations"
    }
  ],
  "services": [
    {
      "binding": "SIGNAL_SERVICE",
      "service": "vgu-signal-worker"
    }
  ],
  "vars": {
    "APP_NAME": "VGU Pulse"
  }
}
